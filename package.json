{
  "name": "plan-it-iitp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@vercel/blob": "2.8.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1"
  },
  "overrides": {
    "zod": "$zod"
  },
  "scripts": {
    "dev": "LOCAL_DEMO=true node server/http.js",
    "start": "node server/http.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "check": "node scripts/check.js",
    "db:migrate": "node --env-file=.env.local server/migrate.js",
    "dev:watch": "LOCAL_DEMO=true node --watch server/http.js",
    "start:configured": "node --env-file=.env.local server/http.js",
    "setup:check": "node --env-file=.env.local scripts/setup-check.js",
    "account:role": "node --env-file=.env.local scripts/set-role.js",
    "waitlist:import": "node --env-file=.env.local scripts/import-waitlist.js",
    "test:staging": "node --env-file=.env.local scripts/staging-smoke.js",
    "test:postgres": "node scripts/test-postgres.js"
  },
  "engines": {
    "node": ">=22"
  }
}
