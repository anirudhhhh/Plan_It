# Copy to .env.local. Keep real values here or in provider dashboards, never in Git/chat.
# Vercel: each Preview (staging) and Production environment needs its own values.

# Server-only. Use Supabase transaction pooler (port 6543) for Vercel runtime.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER:6543/postgres
# Optional session/direct connection for migrations; falls back to DATABASE_URL.
DATABASE_MIGRATION_URL=
# Optional trusted root CA PEM from Supabase; literal \n sequences are accepted.
DATABASE_CA_CERT=

# Public Supabase settings. NEVER use a service_role/sb_secret key here.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY

# One Turnstile widget per environment; put its secret in Supabase Auth too.
TURNSTILE_SITE_KEY=YOUR_PUBLIC_SITE_KEY
TURNSTILE_SECRET=YOUR_SERVER_ONLY_SECRET
# Exact deployed origin, no path; allow this origin/auth/callback in Supabase.
SITE_URL=https://YOUR_DOMAIN

# Configurable contact details. Set the approved support email before launch.
WHATSAPP_NUMBER=918789686217
SUPPORT_EMAIL=
AUTH_PHONE_ENABLED=true
AUTH_GOOGLE_ENABLED=true

# Optional, only for importing the original private Blob waitlist.
# BLOB_READ_WRITE_TOKEN=
# Optional, read-only staging smoke test against a protected Vercel deployment.
# SMOKE_BASE_URL=https://YOUR_STAGING_DOMAIN
# VERCEL_AUTOMATION_BYPASS_SECRET=
# SMOKE_USER_ACCESS_TOKEN=
# SMOKE_OPS_ACCESS_TOKEN=

# Local test database only: DATABASE_SSL=false (only loopback hosts accepted).
# LOCAL_DEMO=true is ignored on Vercel and when NODE_ENV=production.
