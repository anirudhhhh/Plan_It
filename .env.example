# Copy to .env.local. Never commit credentials.
# Supabase project: Mumbai region, enable phone OTP + Google, configure redirect URLs.
DATABASE_URL=postgresql://postgres:password@your-supabase-pooler:6543/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
TURNSTILE_SITE_KEY=your-public-site-key
TURNSTILE_SECRET=your-server-only-secret
SITE_URL=https://your-production-domain.example
# LOCAL_DEMO=true is for explicit local testing only. Ignored in production.
# DATABASE_SSL=false only for a trusted local PostgreSQL instance.
