{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/[...path].js": {
      "includeFiles": "server/**",
      "maxDuration": 30
    },
    "api/page.js": {
      "includeFiles": "{public/index.html,server/**}",
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self'; img-src 'self' https: data:; connect-src 'self' https://*.supabase.co https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/:file(app.js|workflows.js|whatsapp.js|captcha.js|sw.js|styles.css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/health/live",
      "destination": "/api/v1/live"
    },
    {
      "source": "/ready",
      "destination": "/api/v1/ready"
    },
    {
      "source": "/health",
      "destination": "/api/v1/health"
    },
    {
      "source": "/:path((?!api/|assets/|.*\\.).*)",
      "destination": "/api/page?route=/:path"
    }
  ]
}
